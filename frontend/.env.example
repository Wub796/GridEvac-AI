# Copy to frontend/.env.local for local development (that file is untracked).
#
# Every NEXT_PUBLIC_* value is inlined into the browser bundle at build time, so
# on Vercel each one is set per environment (Production, Preview, Development)
# in the project settings and takes effect only on the next build.

# Routing API origin. `start.sh` serves it at http://127.0.0.1:8000.
# A deployed build with this unset solves routes in the browser instead.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# CARTO basemap key (appended to tile URLs; keep attribution visible).
NEXT_PUBLIC_CARTO_API_KEY=

# Cesium ion token: aerial imagery, world terrain, OSM 3D buildings.
NEXT_PUBLIC_CESIUM_TOKEN=
